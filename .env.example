# City Life Application Environment Variables

# Target City Configuration (San Francisco, CA)
CITY_NAME=San Francisco
CITY_COUNTRY=USA
CITY_CENTER_LAT=37.7749
CITY_CENTER_LON=-122.4194
CITY_DEFAULT_ZOOM=13
CITY_BBOX_SOUTH=37.7080
CITY_BBOX_WEST=-122.5200
CITY_BBOX_NORTH=37.8200
CITY_BBOX_EAST=-122.3600

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///backend/citylife.db
# PostgreSQL + PostGIS production example:
# DATABASE_URL=postgresql://citylife_user:securepassword@localhost:5432/citylife_db

# External APIs
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development
